@page "/not-found"
@layout MainLayout
@inject AdminApiClient Api
@inject NavigationManager Navigation

<PageTitle>Page not found · ChurchTranslate</PageTitle>
@if (signedIn)
{
    <main class="dashboard" style="padding-top: 80px"><div class="eyebrow">404 / PAGE NOT FOUND</div><h1>The page isn't here.</h1><p>Return to the control room overview.</p><a href="/">Back to overview →</a></main>
}

@code {
    private bool signedIn;

    protected override async Task OnInitializedAsync()
    {
        try { signedIn = await Api.CurrentUserAsync() is not null; }
        catch { signedIn = false; }
        if (!signedIn) Navigation.NavigateTo("/");
    }
}
